// Administrators (wheel) of the active local session change /Applications after one
// authentication, kept for a few minutes; everyone else needs an administrator's password.
polkit.addRule(function (action, subject) {
    if (action.id === "dev.silica.applications.install" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.AUTH_ADMIN_KEEP;
    }
});
